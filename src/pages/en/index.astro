---
// src/pages/en/index.astro
import Hero from '../../components/home/Hero.astro';
import BrandLoop from '../../components/home/BrandLoop.astro';
import DescriptionContent from '../../components/home/DescriptionContent.astro';
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('home.title')} description={t('home.description')}>
	<main>
		<Hero lang={lang} />
		<BrandLoop lang={lang} />
		<DescriptionContent lang={lang} />
	</main>
</Layout>
