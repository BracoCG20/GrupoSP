---
// src/layouts/Layout.astro
import '../styles/main.scss';
import Header from '../components/shared/Header.astro';
import { getAlternatePaths } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	lang?: 'es' | 'en';
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
}

const {
	title = 'Inicio - GrupoSP',
	description = 'Grupo SP: Holding latinoamericano de Creatividad, Estrategia y Expansión. Impulsamos proyectos en Marketing Services, Retail y Ventures en Perú, Colombia, Panamá, Chile y México.',
	lang = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/') ? 'en' : 'es',
	image = '/bgMain.webp',
	imageAlt = 'GrupoSP Banner Principal',
	imageWidth,
	imageHeight,
} = Astro.props;

const siteUrl = new URL('https://gruposp.pe');
const { es: spanishPath, en: englishPath } = getAlternatePaths(Astro.url.pathname);
const spanishUrl = new URL(spanishPath, siteUrl).toString();
const englishUrl = new URL(englishPath, siteUrl).toString();
const canonicalUrl = lang === 'en' ? englishUrl : spanishUrl;
const imageUrl = image ? new URL(image, siteUrl).toString() : undefined;
const resolvedImageWidth = imageWidth ?? (image === '/bgMain.webp' ? 2912 : undefined);
const resolvedImageHeight = imageHeight ?? (image === '/bgMain.webp' ? 1632 : undefined);
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Cristian Braco" />
		<meta name="google-site-verification" content="hEKie43yzE3FavhvPD12dVFxyoeeHTaOnNXdVtXe14M" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="es" href={spanishUrl} />
		<link rel="alternate" hreflang="en" href={englishUrl} />
		<link rel="alternate" hreflang="x-default" href={spanishUrl} />

		<meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="GrupoSP" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		{imageUrl && <meta property="og:image" content={imageUrl} />}
		{imageUrl && resolvedImageWidth && <meta property="og:image:width" content={resolvedImageWidth.toString()} />}
		{imageUrl && resolvedImageHeight && <meta property="og:image:height" content={resolvedImageHeight.toString()} />}
		{imageUrl && <meta property="og:image:alt" content={imageAlt} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{imageUrl && <meta name="twitter:image" content={imageUrl} />}

		<link rel="icon" href="/logoGrupoSP.ico" sizes="any" />
		<link rel="icon" href="/logo_GrupoSP192.png" type="image/png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header lang={lang} />
		<slot />
	</body>
</html>

