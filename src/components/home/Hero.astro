---
// src/components/home/Hero.astro
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="home-hero" aria-labelledby="home-hero-title">
	<div class="home-hero__content">
		<h1 class="home-hero__title" id="home-hero-title">
			<span class="home-hero__intro">{t('home.hero.intro')}</span>{' '}
			<strong class="home-hero__emphasis">
				{t('home.hero.emphasis')}{' '}
				<span class="home-hero__highlight">{t('home.hero.highlight')}</span>
			</strong>
		</h1>
	</div>
	<a class="home-hero__scroll" href="#description-section" aria-label={t('home.hero.scroll')}>
		<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" width="32" height="32">
			<path d="m5 9 7 7 7-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</a>
</section>
