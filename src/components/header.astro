---
// src/components/header.astro
import { Menu, X } from '@lucide/astro';
import logo from '../assets/logo.webp';
import { getRoutePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const menuLinks = [
	{ route: 'home', label: t('header.home') },
	{ route: 'about', label: t('header.about') },
	{ route: 'companies', label: t('header.companies') },
] as const;
---

<header class="header">
	<nav id="navbar" class="nav" aria-label={t('header.menu.label')}>
		<div class="nav__inner">
			<a href={getRoutePath('home', lang)} class="nav__logo-link" aria-label={t('header.home')}>
				<img id="logo" src={logo.src} alt={t('header.logo')} class="nav__logo" width="130" height="27" />
			</a>
			<button
				id="btnMenu"
				class="nav__toggle"
				type="button"
				aria-expanded="false"
				aria-controls="sidebar"
				aria-label={t('header.menu.open')}
				data-label-open={t('header.menu.open')}
				data-label-close={t('header.menu.close')}
			>
				<Menu class="nav__icon nav__icon--menu" size={32} stroke-width={2.5} aria-hidden="true" />
			</button>
		</div>
	</nav>

	<div id="sidebar" class="sidebar" aria-hidden="true" inert>
		<a
			href={getRoutePath('home', otherLang)}
			class="sidebar__language"
			lang={otherLang}
			hreflang={otherLang}
		>
			{otherLang.toUpperCase()}
		</a>
		<a href={getRoutePath('contact', lang)} class="btn btn--contact">{t('header.contact')}</a>
		<ul class="sidebar__menu">
			{menuLinks.map(({ route, label }) => {
				const href = getRoutePath(route, lang);
				const isActive = currentPath === href;
				return (
					<li class="sidebar__item">
						<a
							href={href}
							class:list={['sidebar__link', { 'sidebar__link--active': isActive }]}
							aria-current={isActive ? 'page' : undefined}
						>
							{label}
						</a>
					</li>
				);
			})}
		</ul>
	</div>
</header>

<script>
	import gsap from 'gsap';

	let cleanupHeader: (() => void) | undefined;

	function initHeader() {
		cleanupHeader?.();
		const header = document.querySelector<HTMLElement>('.header');
		const nav = header?.querySelector<HTMLElement>('.nav');
		const toggle = header?.querySelector<HTMLButtonElement>('.nav__toggle');
		const sidebar = header?.querySelector<HTMLElement>('.sidebar');
		if (!header || !nav || !toggle || !sidebar) return;

		const controller = new AbortController();
		const { signal } = controller;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const links = Array.from(sidebar.querySelectorAll<HTMLAnchorElement>('a'));
		let isOpen = false;

		gsap.set(sidebar, { xPercent: 100, autoAlpha: 0 });

		const updateScrolled = () => nav.classList.toggle('nav--scrolled', window.scrollY > 8);
		updateScrolled();
		window.addEventListener('scroll', updateScrolled, { passive: true, signal });

		const setOpen = (open: boolean, restoreFocus = false) => {
			if (isOpen === open) return;
			isOpen = open;
			gsap.killTweensOf(sidebar);
			toggle.setAttribute('aria-expanded', String(open));
			header.classList.toggle('header--menu-open', open);
			sidebar.toggleAttribute('inert', !open);
			sidebar.setAttribute('aria-hidden', String(!open));

			if (open) {
				sidebar.classList.add('sidebar--active');
				if (reduceMotion.matches) {
					gsap.set(sidebar, { xPercent: 0, autoAlpha: 1 });
					links[0]?.focus({ preventScroll: true });
					return;
				}
				gsap.to(sidebar, {
					xPercent: 0,
					autoAlpha: 1,
					duration: 0.55,
					ease: 'power3.out',
					onComplete: () => links[0]?.focus({ preventScroll: true }),
				});
			} else {
				if (restoreFocus || sidebar.contains(document.activeElement)) {
					toggle.focus({ preventScroll: true });
				}
				if (reduceMotion.matches) {
					gsap.set(sidebar, { xPercent: 100, autoAlpha: 0 });
					sidebar.classList.remove('sidebar--active');
				} else {
					gsap.to(sidebar, {
						xPercent: 100,
						autoAlpha: 0,
						duration: 0.4,
						ease: 'power3.in',
						onComplete: () => sidebar.classList.remove('sidebar--active'),
					});
				}
			}
		};

		toggle.addEventListener('click', () => setOpen(!isOpen, isOpen), { signal });
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen) setOpen(false, true);
		}, { signal });
		document.addEventListener('pointerdown', (event) => {
			if (
				isOpen && event.target instanceof Node &&
				!sidebar.contains(event.target) && !toggle.contains(event.target)
			) setOpen(false);
		}, { signal });

		links.forEach((link) => {
			link.addEventListener('click', () => setOpen(false), { signal });
		});

		cleanupHeader = () => {
			controller.abort();
			gsap.killTweensOf(sidebar);
			header.classList.remove('header--menu-open');
			sidebar.classList.remove('sidebar--active');
			sidebar.setAttribute('aria-hidden', 'true');
			sidebar.setAttribute('inert', '');
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', toggle.dataset.labelOpen ?? '');
			gsap.set(sidebar, { clearProps: 'all' });
		};
	}

	document.addEventListener('astro:page-load', initHeader);
	document.addEventListener('astro:before-swap', () => {
		cleanupHeader?.();
		cleanupHeader = undefined;
	});
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initHeader, { once: true });
	} else {
		initHeader();
	}
</script>
